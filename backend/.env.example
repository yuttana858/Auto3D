PORT=3000
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_LIBRARY_TABLE=auto3d_library
SUPABASE_LIBRARY_BUCKET=auto3d-library

# Microsoft Entra ID
ENTRA_TENANT_ID=REPLACE_ME
ENTRA_CLIENT_ID=REPLACE_ME
ENTRA_ISSUER=https://login.microsoftonline.com/REPLACE_ME/v2.0
ENTRA_JWKS_URL=https://login.microsoftonline.com/REPLACE_ME/discovery/v2.0/keys

# Optional comma-separated role names.
AUTO3D_PUBLISH_ROLES=Auto3D.Publisher,Auto3D.Admin
AUTO3D_ADMIN_ROLES=Auto3D.Admin

# Browser origins allowed to call the API cross-origin.
AUTO3D_ALLOWED_ORIGINS=https://auto3d.example.com

# Request limit, including multipart overhead.
AUTO3D_MAX_REQUEST_BYTES=73400320
