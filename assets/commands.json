    {
      "id": "lighting.restore",
      "title": "Set lighting",
      "category": "Lighting",
      "description": "Apply a lighting configuration obtained from lighting.inspect.",
      "mutates": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "default",
              "hdri"
            ]
          },
          "environment": {
            "type": "string"
          },
          "brightness": {
            "type": "number",
            "minimum": 0,
            "maximum": 3
          },
          "rotation": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "elevation": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "background": {
            "type": "boolean"
          }
        },
        "required": [
          "mode"
        ],
        "additionalProperties": false
      },
      "example": {
        "mode": "default"
      }
    },
