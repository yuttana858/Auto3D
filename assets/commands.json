    {
      "id": "object.transform",
      "title": "Transform object",
      "category": "Objects",
      "description": "Set position in model units, rotation in degrees, and scale. Omitted vectors stay unchanged. Undo supported.",
      "mutates": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "objectId": {
            "type": "string"
          },
          "position": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "rotation": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "scale": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "example": {
        "position": [
          0,
          0,
          0
        ]
      }
    },
    {
      "id": "object.duplicate",
