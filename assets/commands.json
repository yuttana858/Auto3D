    {
      "id": "material.texture",
      "title": "Replace texture image",
      "category": "Materials",
      "description": "Replace a material map from a PNG/JPEG/WebP base64 data URI. Retains UVs and map placement.",
      "mutates": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "index": {
            "type": "number",
            "minimum": 0
          },
          "slot": {
            "type": "string",
            "enum": [
              "map",
              "normalMap",
              "bumpMap",
              "emissiveMap",
              "specularMap",
              "aoMap",
              "displacementMap",
              "metalnessMap"
            ]
          },
          "name": {
            "type": "string"
          },
          "dataUri": {
            "type": "string"
          }
        },
        "required": [
          "index",
          "slot",
          "name",
          "dataUri"
        ],
        "additionalProperties": false
      },
      "example": {}
