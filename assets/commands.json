    {
      "id": "material.set",
      "title": "Set material property",
      "category": "Materials",
      "description": "Set a numeric surface property for a material index; preserves UVs and textures.",
      "mutates": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "index": {
            "type": "number",
            "minimum": 0
          },
          "property": {
            "type": "string",
            "enum": [
              "opacity",
              "roughness",
              "metalness",
              "specularIntensity",
              "bumpScale",
              "normalScale",
              "aoIntensity",
              "displacementScale"
            ]
          },
          "value": {
            "type": "number"
          }
        },
        "required": [
          "index",
          "property",
          "value"
        ],
        "additionalProperties": false
      },
      "example": {
        "index": 0,
        "property": "roughness",
        "value": 0.4
      }
    },
    {
      "id": "material.color",
      "title": "Set base color",
      "category": "Materials",
      "description": "Set a material base color using six-digit hex. Preserves assigned maps.",
      "mutates": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "index": {
            "type": "number",
            "minimum": 0
          },
          "color": {
            "type": "string"
          }
        },
        "required": [
          "index",
          "color"
        ],
        "additionalProperties": false
      },
      "example": {
        "index": 0,
        "color": "#222222"
      }
    },
    {
      "id": "preferences.theme",
      "title": "Set theme",
      "category": "Preferences",
      "description": "Apply and remember a light or dark theme.",
